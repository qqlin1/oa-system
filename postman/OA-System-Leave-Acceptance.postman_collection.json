              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 48 * 60 * 60 * 1000);",
                  "const end = new Date(start.getTime() + 8 * 60 * 60 * 1000);",
